{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/estilos.css",
      "destination": "/estilos.css"
    },
    {
      "source": "/src/assets/images/:path*",
      "destination": "/src/assets/images/:path*"
    },
    {
      "source": "/pagina",
      "destination": "/pagina.html"
    },
    {
      "source": "/pagina.html",
      "destination": "/pagina.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
